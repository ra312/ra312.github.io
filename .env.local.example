# Local environment variables for testing

# Password authentication
# Generate with: node scripts/generate-password-hash.js your-password
BLOG_PASSWORD_HASH=placeholder
BLOG_PASSWORD_SALT=placeholder

# JWT Secret (change in production!)
JWT_SECRET=dev-secret-key-change-in-production

# GitHub OAuth (optional - for GitHub auth testing)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/callback
JWT_SECRET=dev-secret-key

# Repo credentials (optional - for GitHub integration testing)
REPO_OWNER=
REPO_NAME=
TARGET_BRANCH=academic
